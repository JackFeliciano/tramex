[Unit]
Description=Tramex demo
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/tramex
Environment=TRAMEX_BASE=/tramex/
ExecStart=/usr/bin/php -S 127.0.0.1:8111 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tramex
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
